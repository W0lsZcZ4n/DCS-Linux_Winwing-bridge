[Unit]
Description=WinWing DCS Telemetry Bridge
After=network.target

[Service]
Type=simple
# Your path here
ExecStart=/usr/bin/python3 -u %h/Documents/Claude/DCS-Linux_Winwing-bridge/telemetry_bridge.py
Restart=always
RestartSec=5

# The bridge idles at 1Hz when DCS isn't running, so it's safe to keep always-on
# Logs go to journalctl: journalctl --user -u winwing-dcs-bridge -f

[Install]
WantedBy=default.target
