[Unit]
Description=WinWing DCS Telemetry Bridge
After=network.target

[Service]
Type=simple
# Point this at telemetry_bridge.py in your clone. %h expands to your home directory,
# so replace [path_to_telemetry_bridge.py] below with the folder you cloned into, e.g.
#   ExecStart=/usr/bin/python3 -u %h/Documents/DCS-Linux_Winwing-bridge/telemetry_bridge.py
ExecStart=/usr/bin/python3 -u %h[path_to_telemetry_bridge.py]
Restart=always
RestartSec=5

# The bridge idles at 1Hz when DCS isn't running, so it's safe to keep always-on
# Logs go to journalctl: journalctl --user -u winwing-dcs-bridge -f

[Install]
WantedBy=default.target
